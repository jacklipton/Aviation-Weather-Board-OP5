{
  "name": "Orange Pi Dev Hybrid",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "runServices": ["dev"],
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  },
  "extensions": [
    "ms-python.python",
    "ms-vscode.remote-containers",
    "ms-azuretools.vscode-docker"
  ],
  "remoteUser": "root"
}
