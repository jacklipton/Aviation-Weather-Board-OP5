# Environment: local (development) or hardware (production on Orange Pi)
ENVIRONMENT=local

# API Key for CheckWX (Get one at https://www.checkwx.com/api)
CHECKWX_API_KEY=your_api_key_here

# Networking
HOST=0.0.0.0
PORT=8080

# Refresh interval in seconds (default 15 minutes)
REFRESH_SECONDS=900

# Board Configuration
# -------------------
# LED_TYPE: mock (default), WS2812, APA102
LED_TYPE=mock
LED_COUNT=50
LED_PIN=14
LED_BRIGHTNESS=64

# WS2812 SPI Configuration (Orange Pi 5)
WS2812_SPI_BUS=4
WS2812_SPI_DEVICE=1
WS2812_SPI_SPEED_HZ=3200000

# Airports to track (Comma separated ICAO codes)
AIRPORTS=CYGK,CYHM,CYKF,CYND,CYOO,CYOW,CYPQ,CYQA,CYSN,CYTR,CYTZ,CYXU,CYYZ,KBUF,KIAG,KMSS,KOGS

# LED Mapping
# Order of LEDs corresponding to the airports above
LED_ORDER=14,41,44,8,21,7,19,26,35,17,31,48,32,38,36,4,1

# Optional Authentication for Web UI
AUTH_USERNAME=
AUTH_PASSWORD=

# Docker Configuration
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKER_IMAGE_NAME=aviation-weather-board-op5
